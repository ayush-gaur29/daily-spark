# ==============================================================================
# Supabase Edge Functions Environment Secrets (SERVER-SIDE ONLY)
# ==============================================================================
# Set these secrets in Supabase via CLI:
#   npx supabase secrets set STRIPE_SECRET_KEY=sk_test_...
# Or via Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
#
# IMPORTANT:
# NEVER commit the real secret key to git.
# NEVER expose STRIPE_SECRET_KEY to the React frontend.
# ==============================================================================

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
